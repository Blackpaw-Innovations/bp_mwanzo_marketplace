<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mwanzo_inventory_scan_wizard_form" model="ir.ui.view">
        <field name="name">mwanzo.inventory.scan.wizard.form</field>
        <field name="model">mwanzo.inventory.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Inventory">
                <sheet>
                    <group>
                        <group>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="_barcode_scanned" widget="barcode_handler" placeholder="Scan a barcode here"/>
                        </group>
                        <group>
                            <field name="message" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="line_ids" context="{'default_location_id': location_id}">
                            <tree create="false" edit="false" delete="false">
                                <field name="product_id" readonly="1"/>
                                <field name="barcode" readonly="1"/>
                                <field name="location_id" readonly="1"/>
                                <field name="on_hand_qty" readonly="1"/>
                                <field name="counted_qty" readonly="1"/>
                                <field name="difference_qty" readonly="1"/>
                                <button name="action_remove_line" string="Remove" type="object" class="btn-link"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_all" string="Done" type="object" class="btn-primary"/>
                    <button name="action_save_session" string="Refresh" type="object" class="btn-secondary"/>
                    <button name="action_clear" string="Clear" type="object" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable_mwanzo_scan" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.mwanzo.scan</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_mwanzo_inventory_scan"
                        string="Scan Inventory"
                        type="object"
                        class="btn-primary"
                        display="always"/>
            </xpath>
        </field>
    </record>

    <record id="action_server_mwanzo_inventory_scan" model="ir.actions.server">
        <field name="name">Scan Inventory</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="binding_model_id" ref="stock.model_stock_quant"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env['stock.quant'].browse(env.context.get('active_ids', [])).action_open_mwanzo_inventory_scan()</field>
    </record>
</odoo>
