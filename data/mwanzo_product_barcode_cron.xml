<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_mwanzo_product_barcode_backfill" model="ir.cron">
        <field name="name">Mwanzo Product Barcode Backfill</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_backfill_empty_barcodes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall">False</field>
        <field name="active">True</field>
        <field name="cron_name">mwanzo_product_barcode_backfill</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
